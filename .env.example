# Copy to .env and fill in. Never commit .env.

# --- Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=UserAuthentication

# --- Public URLs
API_PORT=5004
WEB_PORT=8080
API_PUBLIC_BASE_URL=http://localhost:5004
FRONTEND_BASE_URL=http://localhost:8080

# --- Tokens (issuer should be the public API URL so OIDC discovery is consistent)
JWT_ISSUER=http://localhost:5004
JWT_AUDIENCE=enterprise-sso-api
JWT_ACCESS_TOKEN_EXPIRATION=15
JWT_REFRESH_TOKEN_EXPIRATION=7

# --- Reverse proxy (CIDR of the proxy network whose X-Forwarded-For is trusted), e.g. 172.16.0.0/12
TRUSTED_PROXY_NETWORK=

# --- Data Protection key encryption (recommended in production; PFX mounted into the container)
DATA_PROTECTION_CERT_PATH=
DATA_PROTECTION_CERT_PASSWORD=

# --- Bootstrap administrator (SuperAdmin) created on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-Me-0n-First-Login!

# --- Seeded first-party application (the admin console's OAuth client id)
SEED_APP_NAME=user-manager
SEED_APP_DESCRIPTION=Administration console
SEED_APP_API_KEY=user-manager

# --- Demo SuperAdmin users (development only)
SEED_DEMO_USERS=false
SEED_TEST_USER_NAME=
SEED_TEST_USER_EMAIL=
SEED_TEST_USER_PASSWORD=
SEED_SSO_USER_NAME=
SEED_SSO_USER_EMAIL=
SEED_SSO_USER_PASSWORD=

# --- File storage (application logos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (verification, magic links, password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Enterprise SSO
EMAIL_REPLY_TO=

# --- Rate limits (per client IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=60

# --- Legacy OpenIddict /connect/token client (optional)
OPENIDDICT_CLIENT_SECRET=
