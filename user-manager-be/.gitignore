# =============================================================================
# User Manager - .gitignore
# =============================================================================

# Secrets and sensitive configuration files
.env
.env.local
.env.development
.env.development.with-prod-data
.env.staging
.env.production
appsettings.Development.json
appsettings.Staging.json
appsettings.Production.json

# Keep only templates and base config
!.env.example
!appsettings.json

