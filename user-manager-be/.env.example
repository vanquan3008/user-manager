# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_PORT=5432

# =============================================================================
# Application
# =============================================================================
APP_NAME=User Manager API
APP_VERSION=1.0.0
APP_ENVIRONMENT=Development
AUTO_MIGRATE=true
API_PORT=5004
API_PUBLIC_BASE_URL=http://localhost:5004
FRONTEND_BASE_URL=http://localhost:4200

# =============================================================================
# ASP.NET Core
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# Database Connection
# =============================================================================
DATABASE_URL=Host=localhost;Port=5432;Database=UserAuthentication;Username=postgres;Password=your_password;SslMode=Disable
DB_SENSITIVE_LOGGING=false
DB_DETAILED_ERRORS=false

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET_KEY=your_base64_jwt_secret_key
JWT_ISSUER=your_jwt_issuer
JWT_AUDIENCE=your_jwt_audience
JWT_ACCESS_TOKEN_EXPIRATION=60
JWT_REFRESH_TOKEN_EXPIRATION=7

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ALLOWED_ORIGIN_1=http://localhost:4200
CORS_ALLOWED_ORIGIN_2=http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# OAuth Configuration
# =============================================================================
OAUTH_ALLOWED_HOST_1=localhost
OAUTH_ALLOWED_HOST_2=your-domain.com
OAUTH_DEFAULT_REDIRECT_URI_1=http://localhost:4200/auth/callback
OAUTH_DEFAULT_REDIRECT_URI_2=https://your-domain.com/oauth/callback
OAUTH_DEFAULT_REDIRECT_URI_3=https://www.your-domain.com/auth/callback
OAUTH_DEFAULT_REDIRECT_URI_4=https://www.your-domain.com/oauth/callback
OAUTH_ALLOW_HTTP_LOCALHOST=true

# =============================================================================
# Cloudinary (File Storage)
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =============================================================================
# Email Settings
# =============================================================================
EMAIL_DISPLAY_NAME=User Manager

# =============================================================================
# Email SMTP Configuration
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_TIMEOUT=30000

# =============================================================================
# Email Sender Configuration
# =============================================================================
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Your App Name
EMAIL_REPLY_TO=support@your-domain.com

# =============================================================================
# Email Templates
# =============================================================================
EMAIL_TEMPLATE_BASE_URL=https://your-domain.com
EMAIL_TEMPLATE_LOGO_URL=https://your-domain.com/assets/logo.png
EMAIL_TEMPLATE_PRIMARY_COLOR=#3B82F6

# =============================================================================
# OpenIddict (OAuth Server)
# =============================================================================
OPENIDDICT_CLIENT_SECRET=your_openiddict_client_secret

# =============================================================================
# Admin User (Seeding)
# =============================================================================
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=your_admin_password

# =============================================================================
# Test Users (Seeding)
# =============================================================================
SEED_TEST_USER_NAME=TestUser
SEED_TEST_USER_EMAIL=testuser@example.com
SEED_TEST_USER_PASSWORD=Password123!

SEED_SSO_USER_NAME=TestSSOUser
SEED_SSO_USER_EMAIL=testsso@example.com
SEED_SSO_USER_PASSWORD=Password123!

# =============================================================================
# Application (Seeding)
# =============================================================================
SEED_APP_NAME=user-manager
SEED_APP_DESCRIPTION=User Management Application for SSO
SEED_APP_API_KEY=your_app_api_key