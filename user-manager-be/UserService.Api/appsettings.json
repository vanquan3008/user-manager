{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "UserDatabase": ""
  },
  "AppSettings": {
    "IsAutoMigrate": true,
    "ApplicationName": "Enterprise SSO",
    "Version": "1.0.0",
    "Environment": "Production",
    "ApiPublicBaseUrl": "",
    "BaseUrl": "",
    "FrontendBaseUrl": "",
    "Jwt": {
      "Issuer": "",
      "Audience": "",
      "SecretKey": "",
      "AccessTokenExpirationMinutes": 15,
      "RefreshTokenExpirationDays": 7
    },
    "Database": {
      "EnableSensitiveDataLogging": false,
      "EnableDetailedErrors": false
    },
    "Cors": {
      "AllowedOrigins": [],
      "AllowCredentials": true
    },
    "RateLimit": {
      "RequestLimit": 100,
      "WindowSeconds": 60,
      "WhitelistedPaths": [
        "/health",
        "/swagger"
      ],
      "AuthRequestLimit": 10,
      "AuthWindowSeconds": 60
    },
    "OAuth": {
      "AllowedRedirectUriHosts": [
        "localhost",
        "www.usermanager.io"
      ],
      "DefaultApplicationAllowedRedirectUris": [
        "http://localhost:4200/auth/callback",
        "https://usermanager.io/oauth/callback",
        "https://www.usermanager.io/auth/callback",
        "https://www.usermanager.io/oauth/callback"
      ],
      "AllowHttpForLocalhost": true
    },
    "Cloudinary": {
      "CloudName": "",
      "ApiKey": "",
      "ApiSecret": ""
    },
    "Swagger": {
      "Enabled": false,
      "RequireAuthentication": false,
      "AllowedIpAddresses": []
    },
    "OpenIddict": {
      "AcceptAnonymousClients": false,
      "AllowPasswordFlow": false,
      "AllowRefreshTokenFlow": true,
      "AllowAuthorizationCodeFlow": true,
      "AllowMagicLinkFlow": false,
      "RequireProofKeyForCodeExchange": true
    },
    "Security": {
      "SessionAbsoluteLifetimeDays": 30,
      "RefreshTokenReuseGraceSeconds": 30,
      "SessionValidationCacheSeconds": 15,
      "MfaChallengeMinutes": 5,
      "MfaRecoveryCodeCount": 10,
      "AuditLogRetentionDays": 365,
      "MaintenanceEnabled": true,
      "SigningKeys": {
        "RotationDays": 90,
        "RetiredKeyRetentionDays": 7,
        "KeySize": 2048
      },
      "ForwardedHeaders": {
        "KnownProxies": [],
        "KnownNetworks": []
      }
    }
  },
  "OpenIddict": {
    "ClientSecret": ""
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "SEED_TEST_USER_NAME": "",
  "SEED_TEST_USER_EMAIL": "",
  "SEED_TEST_USER_PASSWORD": "",
  "SEED_SSO_USER_NAME": "",
  "SEED_SSO_USER_EMAIL": "",
  "SEED_SSO_USER_PASSWORD": "",
  "SEED_APP_NAME": "",
  "SEED_APP_DESCRIPTION": "",
  "SEED_APP_API_KEY": "",
  "EmailSettings": {
    "ApplicationDisplayName": "Enterprise SSO",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UserName": "",
      "Password": "",
      "EnableSsl": true,
      "Timeout": 30000
    },
    "Sender": {
      "FromEmail": "",
      "FromName": "",
      "ReplyToEmail": ""
    },
    "Templates": {
      "TemplatesPath": "EmailTemplates",
      "BaseUrl": "",
      "LogoUrl": "",
      "PrimaryColor": "#4F46E5"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  }
}
