{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "UserDatabase": "${DATABASE_URL}"
  },
  "AppSettings": {
    "IsAutoMigrate": true,
    "ApplicationName": "User Manager API",
    "Version": "1.0.0",
    "Environment": "${ASPNETCORE_ENVIRONMENT}",
    "ApiPublicBaseUrl": "${API_PUBLIC_BASE_URL}",
    "BaseUrl": "${BASE_URL}",
    "FrontendBaseUrl": "${FRONTEND_BASE_URL}",
    "Jwt": {
      "Issuer": "${JWT_ISSUER}",
      "Audience": "${JWT_AUDIENCE}",
      "SecretKey": "${JWT_SECRET_KEY}",
      "AccessTokenExpirationMinutes": 60,
      "RefreshTokenExpirationDays": 7
    },
    "Database": {
      "EnableSensitiveDataLogging": false,
      "EnableDetailedErrors": false
    },
    "Cors": {
      "AllowedOrigins": [
        "${FRONTEND_BASE_URL}"
      ],
      "AllowCredentials": true
    },
    "RateLimit": {
      "RequestLimit": 100,
      "WindowSeconds": 60,
      "WhitelistedPaths": [
        "/health",
        "/swagger"
      ]
    },
    "OAuth": {
      "AllowedRedirectUriHosts": [
        "localhost",
        "www.usermanager.io"
      ],
      "DefaultApplicationAllowedRedirectUris": [
        "http://localhost:4200/auth/callback",
        "https://usermanager.io/oauth/callback",
        "https://www.usermanager.io/auth/callback",
        "https://www.usermanager.io/oauth/callback"
      ],
      "AllowHttpForLocalhost": true
    },
    "Cloudinary": {
      "CloudName": "${CLOUDINARY_CLOUD_NAME}",
      "ApiKey": "${CLOUDINARY_API_KEY}",
      "ApiSecret": "${CLOUDINARY_API_SECRET}"
    },
    "Swagger": {
      "Enabled": false,
      "RequireAuthentication": false,
      "AllowedIpAddresses": []
    },
    "OpenIddict": {
      "AcceptAnonymousClients": true,
      "AllowPasswordFlow": true,
      "AllowRefreshTokenFlow": true,
      "AllowAuthorizationCodeFlow": true,
      "AllowMagicLinkFlow": true,
      "RequireProofKeyForCodeExchange": true
    }
  },
  "OpenIddict": {
    "ClientSecret": "${OPENIDDICT_CLIENT_SECRET}"
  },
  "Admin": {
    "Email": "${ADMIN_EMAIL}",
    "Password": "${ADMIN_PASSWORD}"
  },
  "SEED_TEST_USER_NAME": "${SEED_TEST_USER_NAME}",
  "SEED_TEST_USER_EMAIL": "${SEED_TEST_USER_EMAIL}",
  "SEED_TEST_USER_PASSWORD": "${SEED_TEST_USER_PASSWORD}",
  "SEED_SSO_USER_NAME": "${SEED_SSO_USER_NAME}",
  "SEED_SSO_USER_EMAIL": "${SEED_SSO_USER_EMAIL}",
  "SEED_SSO_USER_PASSWORD": "${SEED_SSO_USER_PASSWORD}",
  "SEED_APP_NAME": "${SEED_APP_NAME}",
  "SEED_APP_DESCRIPTION": "${SEED_APP_DESCRIPTION}",
  "SEED_APP_API_KEY": "${SEED_APP_API_KEY}",
  "EmailSettings": {
    "ApplicationDisplayName": "${EMAIL_DISPLAY_NAME}",
    "Smtp": {
      "Host": "${SMTP_HOST}",
      "Port": "${SMTP_PORT}",
      "UserName": "${SMTP_USERNAME}",
      "Password": "${SMTP_PASSWORD}",
      "EnableSsl": true,
      "Timeout": 30000
    },
    "Sender": {
      "FromEmail": "${EMAIL_FROM}",
      "FromName": "${EMAIL_FROM_NAME}",
      "ReplyToEmail": "${EMAIL_REPLY_TO}"
    },
    "Templates": {
      "TemplatesPath": "EmailTemplates",
      "BaseUrl": "${EMAIL_TEMPLATE_BASE_URL}",
      "LogoUrl": "${EMAIL_TEMPLATE_LOGO_URL}",
      "PrimaryColor": "${EMAIL_TEMPLATE_PRIMARY_COLOR}"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}
